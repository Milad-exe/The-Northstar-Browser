{
  "name": "northstar-browser",
  "version": "1.0.0",
  "description": "productivity web browser",
  "homepage": "https://github.com/Milad-exe/Northstar#readme",
  "bugs": {
    "url": "https://github.com/Milad-exe/Northstar/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Milad-exe/Northstar.git"
  },
  "license": "ISC",
  "author": "Milad Rakhshbahar",
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "postinstall": "node scripts/verify-electron.js",
    "start": "electron .",
    "dev": "node scripts/dev.js",
    "dist": "node scripts/dist.js",
    "dist:win": "node scripts/dist.js win",
    "dist:mac": "node scripts/dist.js mac",
    "dist:linux": "node scripts/dist.js linux",
    "vmp-sign": "node scripts/vmp-sign.js node_modules/electron/dist",
    "test:permissions": "electron scripts/test-permissions.js",
    "smoke": "node scripts/smoke.js",
    "test:unit": "node tests/unit.js",
    "test:e2e": "node tests/e2e.js",
    "test:e2e:quick": "node tests/e2e.js --quick",
    "release": "node scripts/dist.js --publish"
  },
  "build": {
    "appId": "com.northstar.browser",
    "afterPack": "./scripts/vmp-sign.js",
    "electronDownload": {
      "mirror": "https://github.com/castlabs/electron-releases/releases/download/"
    },
    "productName": "Northstar",
    "copyright": "Copyright © 2025 Milad Rakhshbahar",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "app-paths.js",
      "features/**/*",
      "ipc/**/*",
      "preload/**/*",
      "renderer/**/*",
      "locales/**/*",
      "package.json",
      "build-stamp.json",
      "logo.png",
      "logo-win.png",
      "node_modules/**/*",
      "!node_modules/playwright/**",
      "!node_modules/playwright-core/**",
      "!node_modules/@playwright/**",
      "!node_modules/electron-builder/**",
      "!node_modules/app-builder-lib/**",
      "!node_modules/dmg-builder/**",
      "!tests/**",
      "!scripts/**",
      "!**/*.map"
    ],
    "asarUnpack": [
      "node_modules/electron-chrome-extensions/**",
      "node_modules/electron-chrome-web-store/**"
    ],
    "win": {
      "icon": "icons/icon.ico",
      "target": [
        "nsis"
      ],
      "signtoolOptions": {
        "sign": "./scripts/vmp-sign.js"
      }
    },
    "mac": {
      "icon": "icons/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "linux": {
      "icon": "icons/icon.png",
      "target": [
        "AppImage"
      ],
      "syncDesktopName": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "protocols": [
      {
        "name": "Web link",
        "schemes": [
          "http",
          "https"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Milad-exe",
        "repo": "The-Northstar-Browser",
        "releaseType": "draft"
      }
    ]
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "dompurify": "^3.4.10",
    "electron-chrome-extensions": "^4.9.0",
    "electron-chrome-web-store": "^0.13.0",
    "electron-updater": "^6.8.9",
    "tldts": "^7.4.2"
  },
  "devDependencies": {
    "electron": "github:castlabs/electron-releases#v38.8.6+wvcus",
    "electron-builder": "^26.15.3",
    "playwright": "^1.61.1"
  }
}
